# Wonder Light Adventure - Environment Configuration

# APP_URL: The URL where this applet is hosted (used for task links & email callbacks)
APP_URL="http://localhost:3000"

# GEMINI_API_KEY: Required for Gemini AI API calls (if used)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ==============================================================================
# OFFICIAL COMPANY EMAIL CONFIGURATION
# Official Sender: Wonder Light Adventure <wonderlightadventure@gmail.com>
# ==============================================================================
EMAIL_FROM="Wonder Light Adventure <wonderlightadventure@gmail.com>"
GMAIL_USER="wonderlightadventure@gmail.com"

# Gmail App Password (16 characters from Google Account -> Security -> 2-Step Verification -> App Passwords)
# Example: "abcd efgh ijkl mnop" (spaces are automatically stripped)
GMAIL_APP_PASSWORD=""

# Alternative OAuth 2.0 Credentials (Optional, if using Google Cloud Console OAuth instead of App Password)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# Secret salt used for secure cryptographic SHA-256 hashing of 4-digit OTP codes
OTP_SALT="wonder_light_adventure_secure_salt_2026"
